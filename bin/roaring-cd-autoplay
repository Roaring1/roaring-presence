#!/usr/bin/env python3
"""roaring-cd-autoplay -- extremely minimal "Autoplay?" prompt for an audio CD.

Spawned by roaring-cd-presence when a disc shows up and nothing is playing it.
Shows one small menu (kdialog on KDE, zenity otherwise):

    Play full album / Pick a track / Not now

Playback goes through mpv on the raw device (cdda://) rather than through
kio-fuse, which keeps the drive far less busy: no KIO audiocd worker decoding
WAV on the fly while the presence provider is also reading the TOC.  mpv is
started with the JSON IPC socket the provider watches, so the track and the
progress bar are exact instead of guessed from a filename.

mpv specifics (verified against mpv 0.40 on this machine):
  * The device option is --cdda-device.  The old MPlayer-era --cdrom-device
    does not exist any more and makes mpv exit with a fatal option error.
  * cdda:// exposes the whole disc as ONE stream whose CHAPTERS are the
    tracks.  cdda://3 does NOT mean "track 3"; mpv parses the 3 as a device
    or disc-image path and fails.  Track N is selected with --start=#N.

Usage:
    roaring-cd-autoplay [--json PAYLOAD] [--device /dev/srN] [--track N]

PAYLOAD: {"device": "/dev/sr1", "album": ..., "artist": ...,
          "tracks": [{"number": 1, "title": "..."}, ...]}
"""
import argparse
import fcntl
import json
import os
import shutil
import subprocess
import sys
import time

TIMEOUT = 60  # seconds to wait on the dialog before giving up

# <linux/cdrom.h>
CDROM_DRIVE_STATUS = 0x5326
CDS_NO_DISC, CDS_TRAY_OPEN = 1, 2
WATCH_INTERVAL = 2.0
LOG = os.path.expanduser("~/.cache/roaring-presence/autoplay.log")


def runtime_dir() -> str:
    return os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()


def log(message: str) -> None:
    line = "%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), message)
    sys.stderr.write(line)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a", encoding="utf-8") as fh:
            fh.write(line)
    except OSError:
        pass


def drive_status(device: str) -> int:
    """Kernel drive status; CDS_NO_DISC when the device itself went away."""
    try:
        fd = os.open(device, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return CDS_NO_DISC
    try:
        return fcntl.ioctl(fd, CDROM_DRIVE_STATUS, 0)
    except OSError:
        return 0
    finally:
        os.close(fd)


def watch_eject(device: str, pid: int) -> int:
    """Stop playback as soon as the disc is ejected or the drive disappears.

    Runs detached alongside mpv so playback is cleaned up even when the
    presence provider is not running (or was stopped first).  Exits as soon
    as mpv is gone, so there is nothing to leak.
    """
    while True:
        try:
            os.kill(pid, 0)
        except OSError:
            return 0  # player already gone; nothing to do
        status = drive_status(device)
        if status in (CDS_NO_DISC, CDS_TRAY_OPEN):
            log("disc ejected (status %s); stopping player pid %s" % (status, pid))
            for sig in (15, 9):
                try:
                    os.kill(pid, sig)
                except OSError:
                    return 0
                for _ in range(20):
                    time.sleep(0.1)
                    try:
                        os.kill(pid, 0)
                    except OSError:
                        return 0
            return 0
        time.sleep(WATCH_INTERVAL)


def ask(argv: list):
    """Run a dialog helper; return its selection, or None if cancelled."""
    try:
        proc = subprocess.run(
            argv, capture_output=True, text=True, timeout=TIMEOUT, check=False
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        log("dialog failed: %s" % exc)
        return None
    if proc.returncode != 0:
        return None
    return proc.stdout.strip() or None


def choose(title: str, prompt: str, items: list):
    """items: [(key, label)].  Returns key or None."""
    kdialog = shutil.which("kdialog")
    if kdialog:
        argv = [kdialog, "--title", title, "--menu", prompt]
        for key, label in items:
            argv += [key, label]
        return ask(argv)

    zenity = shutil.which("zenity")
    if zenity:
        argv = [
            zenity,
            "--list",
            "--title",
            title,
            "--text",
            prompt,
            "--hide-header",
            "--column",
            "key",
            "--column",
            "label",
            "--hide-column",
            "1",
            "--print-column",
            "1",
        ]
        for key, label in items:
            argv += [key, label]
        return ask(argv)

    log("no kdialog or zenity available")
    return None


def mpv_argv(device: str, track) -> list:
    socket = os.path.join(runtime_dir(), "mpv-ipc.sock")
    argv = [
        "mpv",
        "--no-video",
        "--cdda-device=%s" % device,
        "--input-ipc-server=%s" % socket,
        "--idle=no",
        "--keep-open=no",
        "--msg-level=all=warn",
    ]
    if track:
        # Tracks are chapters of the single cdda:// stream.
        argv.append("--start=#%d" % int(track))
    argv.append("cdda://")
    return argv


def play(device: str, track) -> int:
    argv = mpv_argv(device, track)

    # Escape the presence provider's systemd cgroup when possible: otherwise a
    # `systemctl --user restart roaring-cd-presence@srN` kills playback too,
    # because mpv would be a child of that service.
    systemd_run = shutil.which("systemd-run")
    if systemd_run and os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        argv = [
            systemd_run,
            "--user",
            "--scope",
            "--collect",
            "--quiet",
            "--unit=roaring-cd-autoplay-%d" % int(time.time()),
        ] + argv

    log("playing: %s" % " ".join(argv))
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        sink = open(LOG, "a", encoding="utf-8")
    except OSError:
        sink = subprocess.DEVNULL
    try:
        proc = subprocess.Popen(
            argv,
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=sink,
            stderr=subprocess.STDOUT,
        )
    except OSError as exc:
        log("mpv failed to start: %s" % exc)
        return 1

    # Watch for eject in a detached child.  When mpv runs inside its own
    # systemd scope the pid we hold is systemd-run's, whose lifetime still
    # tracks the player, so signalling it stops playback either way.
    try:
        subprocess.Popen(
            [
                sys.executable,
                os.path.abspath(__file__),
                "--watch-eject",
                "--device",
                device,
                "--watch-pid",
                str(proc.pid),
            ],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=sink,
            stderr=subprocess.STDOUT,
        )
    except OSError as exc:
        log("eject watchdog failed to start: %s" % exc)
    return 0


def main(argv: list) -> int:
    parser = argparse.ArgumentParser(description="Minimal audio CD autoplay prompt")
    parser.add_argument("--json", dest="payload", default="{}")
    parser.add_argument("--device", default=None)
    parser.add_argument(
        "--track",
        type=int,
        default=None,
        help="skip the prompt and play this track immediately",
    )
    parser.add_argument(
        "--album",
        action="store_true",
        help="skip the prompt and play the whole disc immediately",
    )
    parser.add_argument(
        "--watch-eject",
        action="store_true",
        help="internal: watch the drive and stop --watch-pid on eject",
    )
    parser.add_argument("--watch-pid", type=int, default=None)
    args = parser.parse_args(argv)

    try:
        payload = json.loads(args.payload or "{}")
    except ValueError:
        payload = {}

    device = args.device or payload.get("device") or "/dev/sr0"

    if args.watch_eject:
        if not args.watch_pid:
            log("--watch-eject needs --watch-pid")
            return 2
        return watch_eject(device, args.watch_pid)
    tracks = payload.get("tracks") or []
    album = payload.get("album") or "Audio CD"
    artist = payload.get("artist")
    label = "%s \u2014 %s" % (artist, album) if artist else album

    if not shutil.which("mpv"):
        log("mpv is not installed")
        return 2

    if args.album:
        return play(device, None)
    if args.track:
        return play(device, args.track)

    items = [("album", "Play full album")]
    if tracks:
        items.append(("track", "Pick a track\u2026"))
    items.append(("no", "Not now"))

    picked = choose("Audio CD inserted", label, items)
    if picked in (None, "no"):
        return 0
    if picked == "album":
        return play(device, None)

    entries = [
        (str(item.get("number")), "%s. %s" % (item.get("number"), item.get("title")))
        for item in tracks
        if item.get("number")
    ]
    number = choose("Play track", label, entries)
    if not number or not number.isdigit():
        return 0
    return play(device, int(number))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
