[Unit]
Description=Audio CD player session (%I)
Conflicts=roaring-cd-presence@%i.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=exec
ExecStart=%h/.local/bin/roaring-cd-presence --player-only /dev/%I
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=8s
Slice=background.slice
Nice=5
