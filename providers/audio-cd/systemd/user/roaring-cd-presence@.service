[Unit]
StartLimitIntervalSec=600
StartLimitBurst=10
Description=Audio CD session (%I)
Conflicts=roaring-cd-player@%i.service

[Service]
Type=exec
ExecStart=%h/.local/bin/roaring-cd-presence /dev/%I
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=8s
Slice=background.slice
Nice=5
