{
  "client_id": "",
  "ipc_socket_candidates": [
    "$XDG_RUNTIME_DIR/discord-ipc-{i}",
    "$TMPDIR/discord-ipc-{i}",
    "$TMP/discord-ipc-{i}",
    "$TEMP/discord-ipc-{i}",
    "/tmp/discord-ipc-{i}",
    "$XDG_RUNTIME_DIR/app/com.discordapp.Discord/discord-ipc-{i}",
    "$XDG_RUNTIME_DIR/app/dev.vencord.Vesktop/discord-ipc-{i}",
    "$XDG_RUNTIME_DIR/.flatpak/com.discordapp.Discord/xdg-run/discord-ipc-{i}",
    "$XDG_RUNTIME_DIR/.flatpak/dev.vencord.Vesktop/xdg-run/discord-ipc-{i}",
    "$XDG_RUNTIME_DIR/snap.discord/discord-ipc-{i}",
    "$XDG_RUNTIME_DIR/snap.discord-canary/discord-ipc-{i}"
  ],
  "idle_exit_seconds": 1,
  "priorities": {
    "cd": 50,
    "minecraft": 10
  },
  "assets": {
    "cd": "cd",
    "play": "play",
    "pause": "pause",
    "minecraft": "minecraft"
  },
  "cd": {
    "device": "auto",
    "poll_seconds": 3,
    "idle_poll_seconds": 6,
    "status_display_type": 2,
    "lookup_musicbrainz": true,
    "use_cover_art_archive": true,
    "mpv_ipc_socket": "$XDG_RUNTIME_DIR/mpv-ipc.sock",
    "show_progress_bar": true,
    "progress_drift_seconds": 2.5,
    "cd_info_timeout": 45,
    "cd_info_attempts": 2,
    "kernel_toc_first": true,
    "kernel_cdtext": true,
    "cdtext_probe_timeout": 12,
    "metadata_grace_seconds": 2,
    "autoplay_prompt": true,
    "preload": true,
    "preload_idle_seconds": 60,
    "player_ui": true,
    "player_poll_seconds": 1,
    "player_idle_poll_seconds": 3,
    "links": {
      "track": "https://music.youtube.com/search?q=%(query)s",
      "album": "https://musicbrainz.org/release/%(release_id)s",
      "album_fallback": "https://music.youtube.com/search?q=%(album_query)s"
    }
  },
  "minecraft": {
    "poll_seconds": 10,
    "wait_seconds": 0,
    "status_display_type": 0,
    "show_instance": true,
    "read_logs": true,
    "show_world": true
  },
  "log_level": "info"
}
