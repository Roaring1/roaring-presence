[Unit]
Description=Minecraft presence provider for roaring-presenced
Documentation=file:///home/roaring/bin/roaring-minecraft-presence
After=graphical-session.target
ConditionPathExists=%h/bin/roaring-minecraft-presence

[Service]
# Deliberately not [Install]ed: start it from a launcher hook, e.g. a
# PrismLauncher pre-launch command:
#   systemctl --user start --no-block roaring-minecraft-presence.service
# The provider waits for the JVM to appear, publishes while it lives, then
# clears its activity and exits, letting the manager idle out on its own.
Type=exec
ExecStart=%h/bin/roaring-minecraft-presence --wait 120
Restart=no
TimeoutStopSec=10
Slice=background.slice
